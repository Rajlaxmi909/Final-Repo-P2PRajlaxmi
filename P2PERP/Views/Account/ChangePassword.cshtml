@model P2PLibray.Account.Account

@{
    Layout = null; // No master layout for this page
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Change Password</title>

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="~/Content/images/favicon/favicon.ico" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="~/Content/font-family-inter.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/Content/assets/vendor/fonts/iconify-icons.css" />

    <!-- Core CSS -->
    <link rel="stylesheet" href="~/Content/assets/vendor/libs/node-waves/node-waves.css" />
    <link rel="stylesheet" href="~/Content/assets/vendor/libs/pickr/pickr-themes.css" />
    <link rel="stylesheet" href="~/Content/assets/vendor/css/core.css" />
    <link rel="stylesheet" href="~/Content/assets/css/demo.css" />
    <link rel="stylesheet" href="~/Content/toastr.min.css" />

    <!-- Vendor CSS -->
    <link rel="stylesheet" href="~/Content/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.css" />
    <link rel="stylesheet" href="~/Content/form-validation.css" />

    <!-- Page Specific CSS (Auth Page) -->
    <link rel="stylesheet" href="~/Content/page-auth.css" />

    <!-- jQuery -->
    <script src="~/Scripts/jquery-3.7.1.js"></script>
    <script src="~/Scripts/toastr.min.js"></script>
    <style>
        #Logo{
            width:300px;
        }
    </style>
</head>
<body style="background: linear-gradient(to bottom, #58a8c8, #4eb8d8);">
    <div class="container body-content">
        <!-- Reset Password Section -->
        <div class="position-relative">
            <div class="authentication-wrapper authentication-cover">
                <!-- Logo -->
                <a href="index.html" class="auth-cover-brand d-flex align-items-center gap-3">
                    <span class="app-brand-logo demo">
                        <span class="text-primary">
                            <img src="~/Content/images/Logo-p2p-removebg-preview.png" alt="LOGO" id="Logo"/>
                        </span>
                    </span>
                    <span class="app-brand-text demo text-heading fw-semibold"></span>
                </a>
                <!-- /Logo -->
                <div class="authentication-inner row m-0">

                    <!-- Left Side Illustration -->
                    <div class="d-none d-lg-flex col-lg-7 col-xl-8 align-items-center justify-content-center p-12 pb-2">
                        <div>
                            <img src="~/Content/images/illustrations/NewBG.png"
                                 class="authentication-image-model d-none d-lg-block" alt="auth-model" />
                        </div>
                    </div>
                    <!-- /Left Section -->
                    <!-- Right Side Form -->
                    <div class="d-flex col-12 col-lg-5 col-xl-4 align-items-center authentication-bg position-relative py-sm-5 px-12 py-4">
                        <div class="w-px-400 mx-auto pt-12 pt-lg-0">
                            <h4 class="mb-8 text-primary fw-semibold text-capitalize">Reset Password 🔒</h4>
                            <p class="mb-5 text-warning fs-5">Your new password must be different from previously used passwords</p>

                            <!-- Reset Password Form Posts to Account/ChangePassword -->
                            @using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post, new { @id = "formAuthentication", @class = "mb-5", data_page = "changePassword" }))
                            {
                                <!-- New Password Input -->
                                <div class="mb-5 form-password-toggle form-control-validation">
                                    <div class="input-group input-group-merge">
                                        <div class="form-floating form-floating-outline">
                                            @Html.PasswordFor(m => m.Password, new
                                            {
                                                @class = "form-control",
                                                @id = "password",
                                                placeholder = "••••••••••",
                                                aria_describedby = "password"
                                            })
                                            <label for="password">New Password</label>
                                        </div>
                                        <!-- Eye icon to toggle show/hide password -->
                                        <span class="input-group-text cursor-pointer">
                                            <i class="icon-base ri ri-eye-off-line icon-20px"></i>
                                        </span>
                                    </div>
                                </div>

                                <!-- Confirm Password Input -->
                                <div class="mb-5 form-password-toggle form-control-validation">
                                    <div class="input-group input-group-merge">
                                        <div class="form-floating form-floating-outline">
                                            @Html.PasswordFor(m => m.ConfirmPassword, new
                                            {
                                                @class = "form-control",
                                                @id = "confirm-password",
                                                placeholder = "••••••••••",
                                                aria_describedby = "password"
                                            })
                                            <label for="confirm-password">Confirm Password</label>
                                        </div>
                                        <!-- Eye icon toggle -->
                                        <span class="input-group-text cursor-pointer">
                                            <i class="icon-base ri ri-eye-off-line icon-20px"></i>
                                        </span>
                                    </div>
                                </div>

                                <!-- Submit Button -->
                                <button type="submit" class="btn btn-primary d-grid w-100 mb-5">Set new password</button>

                                <!-- Back to Login Link -->
                                <div class="text-center">
                                    <a href="@Url.Action("MainLogin", "Account")" class="d-flex align-items-center justify-content-center">
                                        <i class="icon-base ri ri-arrow-left-s-line scaleX-n1-rtl icon-20px me-1_5"></i>
                                        Back to login
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                    <!-- /Reset Password -->
                </div>
            </div>
        </div>
        <!-- / Content -->
    </div>

    <!-- JS Libraries -->
    <script src="~/Scripts/sweetalert2@11.js"></script>
    <script src="~/Content/assets/vendor/libs/popper/popper.js"></script>
    <script src="~/Content/assets/vendor/js/bootstrap.js"></script>
    <script src="~/Content/assets/vendor/libs/node-waves/node-waves.js"></script>
    <script src="~/Scripts/autocomplete-js.js"></script>
    <script src="~/Content/assets/vendor/libs/pickr/pickr.js"></script>
    <script src="~/Content/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
    <script src="~/Content/assets/vendor/libs/hammer/hammer.js"></script>
    <script src="~/Content/assets/vendor/js/menu.js"></script>

    <!-- Form Validation -->
    <script src="~/Scripts/popular.js"></script>
    <script src="~/Scripts/bootstrap5.js"></script>
    <script src="~/Scripts/auto-focus.js"></script>

    <!-- Main JS -->
    <script src="~/Scripts/pages-auth.js"></script>
    <script src="~/Scripts/Login.js"></script>

    <script>
        // Toggle show/hide password on eye icon click
        document.querySelectorAll('.form-password-toggle i').forEach(function (icon) {
            icon.addEventListener('click', function (event) {
                event.preventDefault();
                const inputGroup = icon.closest('.input-group');
                const input = inputGroup.querySelector('input');

                if (input) {
                    const isPassword = input.type === 'password';
                    input.type = isPassword ? 'text' : 'password';

                    icon.classList.toggle('ri-eye-line', isPassword);
                    icon.classList.toggle('ri-eye-off-line', !isPassword);
                }
            });
        });
    </script>
</body>
</html>
