@model P2PLibray.Account.Account

@{
    Layout = null;  // No layout is used for this page
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Forgot Password</title>

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="~/Content/images/favicon/favicon.ico" />

    <!-- Google Fonts -->
    <link rel="stylesheet" href="~/Content/assets/vendor/fonts/iconify-icons.css" />

    <!-- Core CSS -->
    <link rel="stylesheet" href="~/Content/assets/vendor/libs/node-waves/node-waves.css" />
    <link rel="stylesheet" href="~/Content/assets/vendor/libs/pickr/pickr-themes.css" />
    <link rel="stylesheet" href="~/Content/assets/vendor/css/core.css" />
    <link rel="stylesheet" href="~/Content/assets/css/demo.css" />
    <link rel="stylesheet" href="~/Content/toastr.min.css" />

    <!-- Vendor CSS -->
    <link rel="stylesheet" href="~/Content/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.css" />
    <link rel="stylesheet" href="~/Content/form-validation.css" />

    <!-- Page Specific CSS (Auth Page) -->
    <link rel="stylesheet" href="~/Content/page-auth.css" />

    <!-- Helpers (must be loaded before config/theme js) -->
    <!-- jQuery -->
    <script src="~/Scripts/jquery-3.7.1.js"></script>
    <script src="~/Scripts/toastr.min.js"></script>
    <style>
        #Logo {
            width: 300px;
        }
    </style>
</head>
<body style="background: linear-gradient(to bottom, #58a8c8, #4eb8d8);">
    <div class="container body-content">
        <!-- Page wrapper -->
        <div class="authentication-wrapper authentication-cover">

            <!-- Application logo -->
            <div class="auth-cover-brand d-flex align-items-center gap-3">
                <span class="app-brand-logo demo">
                    <span class="text-primary">
                        <!-- Company Logo (SVG) -->
                        <img src="~/Content/images/Logo-p2p-removebg-preview.png" alt="LOGO" id="Logo" />

                    </span>
                </span>
           
            </div>
            <!-- End Logo -->
            <div class="authentication-inner row m-0">
                <!-- Left section containing illustration -->
                <div class="d-none d-lg-flex col-lg-7 col-xl-8 align-items-center justify-content-center p-12 pb-2">
                    <div>
                        <img src="~/Content/images/illustrations/NewBG.png"
                             class="authentication-image-model d-none d-lg-block" alt="auth-model" />
                    </div>
                </div>
                <!-- End Left section -->
                <!-- Right section for Forgot Password form -->
                <div class="d-flex col-12 col-lg-5 col-xl-4 align-items-center authentication-bg p-sm-12 p-6">
                    <div class="w-px-400 mx-auto">
                        <h4 class="mb-8 text-primary fw-semibold">Forgot Password? 🔒</h4>
                        <p class="mb-5 text-warning fs-5 text-capitalize">Enter your email and we'll send you a code to reset your password</p>

                        <!-- Forgot password form -->
                        @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { @id = "formAuthentication", @class = "mb-5", data_page = "sendCode" }))
                        {
                            @Html.AntiForgeryToken()
                            <div class="form-floating form-floating-outline mb-5 form-control-validation">
                                <!-- Input for email address -->
                                @Html.TextBoxFor(m => m.EmailAddress, new
                                {
                                    @class = "form-control",
                                    @id = "email",
                                    placeholder = "Enter your email",
                                    autofocus = "autofocus"
                                })
                                <label for="email">Email</label>
                                @Html.ValidationMessageFor(m => m.EmailAddress, "", new { @class = "text-danger" })
                            </div>

                            <!-- Submit button -->
                            <button type="submit" class="btn btn-primary d-grid w-100 mb-5 text-white">
                                Verify
                            </button>
                        }

                        <!-- Back to login link -->
                        <div class="text-center">
                            <a href="@Url.Action("MainLogin", "Account" )"
                               class="d-flex align-items-center justify-content-center">
                                <i class="icon-base ri ri-arrow-left-s-line scaleX-n1-rtl icon-20px me-1_5"></i>Back to login
                            </a>
                        </div>
                    </div>
                </div>
                <!-- End Forgot Password -->
            </div>
        </div>
        <!-- End Page wrapper -->
    </div>

    <!-- JS Libraries -->
    <script src="~/Scripts/sweetalert2@11.js"></script>
    <script src="~/Content/assets/vendor/libs/popper/popper.js"></script>
    <script src="~/Content/assets/vendor/js/bootstrap.js"></script>
    <script src="~/Content/assets/vendor/libs/node-waves/node-waves.js"></script>
    <script src="~/Scripts/autocomplete-js.js"></script>
    <script src="~/Content/assets/vendor/libs/pickr/pickr.js"></script>
    <script src="~/Content/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
    <script src="~/Content/assets/vendor/libs/hammer/hammer.js"></script>
    <script src="~/Content/assets/vendor/js/menu.js"></script>

    <!-- Form Validation -->
    <script src="~/Scripts/popular.js"></script>
    <script src="~/Scripts/bootstrap5.js"></script>
    <script src="~/Scripts/auto-focus.js"></script>

    <!-- Main JS -->
    <script src="~/Scripts/Login.js"></script>
    <script src="~/Scripts/SendEmail.js"></script>

    <script>

        $(document).ready(function () {
            $("#formAuthentication").on("submit", function (e) {
                e.preventDefault();

                console.log("Submit handler entered");
                const email = $("#email").val().trim();

                if (!email) {
                    Swal.fire("Error", "Please enter your email.", "error");
                    return;
                }

                const code = Math.floor(100000 + Math.random() * 900000);

                // Step 1: Verify Email
                $.ajax({
                    url: "/Account/ForgotPassword",
                    type: "POST",
                    data: { EmailAddress: email, Code: code },
                    success: function (res) {
                        if (!res.success) {
                            Swal.fire("Error", res.message, "error");
                            return;
                        }

                        // Build email data
                        const emailObj = {
                            ToEmails: [email],
                            Subject: "Your Password Reset Code",
                            Body: `<div style="font-family: sans-serif; text-align: center; border: 1px solid #eee; padding: 20px; background: linear-gradient(to bottom, #58a8c8, #4eb8d8);">
                            <img src="cid:companylogo" alt="LOGO" style="width: 200px; margin-bottom: 20px;" />
                            <h2 style='color:#000; font-size: 32px; letter-spacing: 5px; margin: 10px 0;'>${code}</h2>
                            <p style="font-size: 16px; color: #333;">This reset code is valid for 10 minutes.</p>
                            <p style="color: #333; font-size: 12px;">You are receiving this because you (or someone else) have requested the reset of the password for your account.</p>
                            <p style="color: #333; font-size: 12px;">If you did not request this, please ignore this email and your password will remain unchanged.</p>
                           </div>`,
                            IsBodyHtml: true,
                            CcEmails: [],
                            BccEmails: [],
                            AttachmentPaths: []
                        };

                        // Build FormData
                        const formData = new FormData();
                        formData.append("email", JSON.stringify(emailObj));

                        //formData.append("__RequestVerificationToken", $('input[name="__RequestVerificationToken"]').val());

                        // If you ever have file attachments:
                        if (typeof mailAttachment !== "undefined" && mailAttachment) {
                            formData.append("mailAttachment", mailAttachment);
                        }

                        // SweetAlert config
                        const swalConfig = {
                            title: "Sending Email...",
                            html: "<b>Please wait</b> while we send your reset code to your inbox.",
                            html2: "Redirecting to verification page....",
                            willClose: () => {
                                window.location.href = '/Account/VerifyCode';
                            }
                        };

                        // Step 4: Call sendEmailAjax (assuming it handles AJAX)
                        sendEmailAjax(formData, swalConfig);
                    },
                    error: function () {
                        Swal.fire("Error", "Something went wrong while verifying email.", "error");
                    }
                });
            });
        });
    </script>

</body>
</html>
