


@{
    ViewBag.Title = "Material Requirement Planning";
}

<div class="container-fluid bg-white" style="min-height:auto">
    <h3 class="text-center text-primary">Material Requirement Planning</h3>

    <form id="stockForm" novalidate>
        <div class="row g-3">

            <!-- Item Dropdown -->
            <div class="col-md-6">
                <label for="itemName" class="form-label form-label-sm fw-bold text-dark">Item Name <span class="required-star">*</span></label>
                <select id="itemName" class="form-select form-select-sm item-select shadow-sm">
                    <option value="">-- Select Item --</option>
                </select>
                <small id="itemError" class="text-danger d-none"></small>
            </div>

            <!-- Plan Name -->
            <div class="col-md-6">
                <label for="planName" class="form-label form-label-sm fw-bold text-dark">Plan Name <span class="required-star">*</span></label>
                <input type="text" id="planName" class="form-control form-control-sm  text-dark shadow-sm" />
                <small id="planError" class="text-danger d-none"></small>
            </div>

            <!-- Year -->
            <div class="col-md-2">
                <label for="year" class="form-label form-label-sm fw-bold text-dark">Year</label>
                <input type="text" id="year" class="form-control bg-light form-control-sm  text-dark shadow-sm" readonly />
            </div>

            <!-- Item Code -->
            <div class="col-md-5">
                <label for="itemCode" class="form-label form-label-sm fw-bold text-dark">Item Code</label>
                <input type="text" id="itemCode" class="form-control bg-light form-control-sm  text-dark shadow-sm" readonly />
            </div>

            <!-- UOM -->
            <div class="col-md-5">
                <label for="uom" class="form-label form-label-sm fw-bold text-dark">UOM</label>
                <input type="text" id="uom" class="form-control bg-light form-control-sm  text-dark shadow-sm" readonly />
            </div>

            <!-- Quantity -->
            <div class="col-md-6">
                <label for="quantity" class="form-label form-label-sm fw-bold text-dark">Quantity <span class="required-star">*</span></label>
                <input type="number" id="quantity" class="form-control form-control-sm  text-dark shadow-sm" />
                <small id="qtyError" class="text-danger d-none"></small>
            </div>

            <!-- Description -->
            <div class="col-md-6">
                <label for="description" class="form-label form-label-sm fw-bold text-dark">Description</label>
                <textarea id="description" class="form-control bg-light form-control-sm  text-dark shadow-sm" readonly></textarea>
            </div>

            <!-- Add Button -->
            <div class="col-md-12 text-end">
                <button type="button" id="btnAdd" class="btn btn-success mt-2 btn-sm ">
                    <i class="bi bi-plus-circle me-2"></i> Add Item
                </button>
            </div>

            <hr />

            <!-- Table -->
            <div class="table-responsive mt-2">
                <table id="itemsTable" class="table table-striped table-bordered text-center align-middle">
                    <thead class="table-dark text-center">
                        <tr>
                            <th>Item Name</th>
                            <th>Item Code</th>
                            <th>Quantity</th>
                            <th>UOM</th>
                            <th>Description</th>
                            <th>Request Type</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>

            <!-- Dates -->
            <div class="row ">
                <div class="col-md-3">
                    <label class="form-label form-label-sm fw-bold text-dark">From Date <span class="required-star">*</span></label>
                    <input type="date" id="fromDate" class="form-control form-control-sm  text-dark shadow-sm" />
                    <small id="fromDateError" class="text-danger d-none"></small>
                </div>
                <div class="col-md-3 mb-2">
                    <label class="form-label form-label-sm fw-bold text-dark">To Date <span class="required-star">*</span></label>
                    <input type="date" id="toDate" class="form-control form-control-sm  text-dark shadow-sm" />
                    <small id="toDateError" class="text-danger d-none"></small>
                </div>
            </div>

            <div class="text-center mb-4">
                <button type="submit" class="btn btn-success btn-sm ">Send for Approval</button>
            </div>
        </div>
    </form>
</div>

<style>
    label {
        font-weight: 600;
    }

    .form-control[readonly] {
        background-color: #f8f9fa;
    }

    .container-fluid {
        max-width: 1400px !important;
        margin-left: auto;
        margin-right: auto;
    }

    .required-star {
        color: red;
        font-size: 1em;
        font-weight: bold;
        vertical-align: middle;
        position: relative;
        top: -4px;
    }

    .error-border {
        border: 2px solid #dc3545 !important;
        box-shadow: 0 0 6px rgba(220, 53, 69, 0.25);
    }

    /* Center table content */
    #itemsTable th, #itemsTable td {
        text-align: center;
        vertical-align: middle;
    }
   textarea {
        height: 40px;
    }
</style>

<script>
    let allItems = [];
    let itemList = [];
    let table;

    $(document).ready(function () {

        $('#year').val(new Date().getFullYear());
        // Get Today Date
        var today = new Date();

        // Add 1 Month
        today.setMonth(today.getMonth() + 1);

        // Format Date yyyy-mm-dd
        var minFromDate = today.toISOString().split('T')[0];

        // Set From Date Minimum = Today + 1 Month
        $('#fromDate').attr("min", minFromDate);


        // When From Date Changes
        $('#fromDate').on('change', function () {

            var fromDate = new Date($(this).val());

            // Add 1 Day (Because To Date must be > From Date)
            fromDate.setDate(fromDate.getDate() + 1);

            var minToDate = fromDate.toISOString().split('T')[0];

            // Set To Date Minimum = From Date + 1 Day
            $('#toDate').attr("min", minToDate);

            // Clear To Date if invalid
            if ($('#toDate').val() < minToDate) {
                $('#toDate').val('');
            }
        });


        // Extra Safety Validation
        $('#toDate').on('change', function () {

            var fromDate = new Date($('#fromDate').val());
            var toDate = new Date($(this).val());

            if (toDate <= fromDate) {
                alert("To Date must be greater than From Date");
                $(this).val('');
            }
        });


        $.get('/Inventory/GetItemListMHB', function (items) {
            allItems = items;
            updateItemDropdown();
        });

        $('#itemName').on('change', function () {
            const itemId = $(this).val();
            if (!itemId) return;
            $.get('/Inventory/GetItemDetailsMHB', { itemId: itemId }, function (item) {
                $('#itemCode').val(item.ItemCode);
                $('#uom').val(item.UOMName);
                $('#description').val(item.Description);
            });
        });

        // Initialize DataTable
        table = $('#itemsTable').DataTable({
            paging: true, searching: true, ordering: false, info: false, lengthChange: false,
            language: { emptyTable: "No items added yet." }
        });


        $('#quantity').on('input', function () {
            const qtyInput = $(this);
            const qty = parseInt(qtyInput.val(), 10);
            const maxQty = 100000;


            // 🔹 Validate Quantity
            if (isNaN(qty) || qty <= 0 || qty > maxQty) {
                qtyInput.val(maxQty);
            }
        });


        // Live validation removal
        $('#itemName, #planName, #quantity, #fromDate, #toDate').on('input change', function () {
            const id = $(this).attr('id');
            const errElem = $('#' + id + 'Error');
            clearError($(this), errElem);
        });

        // Add item button
        $('#btnAdd').click(function () {
            clearError($('#itemName'), $('#itemError'));
            clearError($('#quantity'), $('#qtyError'));

            const itemId = $('#itemName').val();
            const itemName = $('#itemName option:selected').text();
            const itemCode = $('#itemCode').val();
            const uom = $('#uom').val();
            const qty = $('#quantity').val();
            const desc = $('#description').val();

            if (!itemId) {
                showError($('#itemName'), $('#itemError'), 'Please select an item.');
                return;
            }
            if (!qty || qty <= 0) {
                showError($('#quantity'), $('#qtyError'), 'Please enter a valid quantity.');
                return;
            }

            if (itemList.some(x => x.ItemId == itemId)) {
                Swal.fire('Duplicate', 'This item is already added.', 'warning');
                return;
            }

            const item = {
                ItemId: itemId,
                ItemName: itemName,
                ItemCode: itemCode,
                Quantity: qty,
                QuantityMRP: qty,
                UOM: uom,
                Description: desc,
                RequestType: "MRP"
            };

            itemList.push(item);
            renderTable();
            updateItemDropdown();
            clearFields();
        });

        // Remove item
        $('#itemsTable tbody').on('click', '.btn-remove', function () {
            const row = $(this).closest('tr');
            const itemCode = row.find('td:eq(1)').text();
            itemList = itemList.filter(x => x.ItemCode !== itemCode);
            renderTable();
            updateItemDropdown();
        });

        // Form submit
        $('#stockForm').on('submit', function (e) {
            e.preventDefault();
            let valid = true;

            const planName = $('#planName').val().trim();
            const fromDate = $('#fromDate').val();
            const toDate = $('#toDate').val();

            clearError($('#planName'), $('#planError'));
            clearError($('#fromDate'), $('#fromDateError'));
            clearError($('#toDate'), $('#toDateError'));

            if (!planName) {
                showError($('#planName'), $('#planError'), 'Please enter Plan Name.');
                valid = false;
            }
            if (!fromDate) {
                showError($('#fromDate'), $('#fromDateError'), 'Please select From Date.');
                valid = false;
            }
            if (!toDate) {
                showError($('#toDate'), $('#toDateError'), 'Please select To Date.');
                valid = false;
            }
            if (fromDate && toDate && toDate < fromDate) {
                showError($('#toDate'), $('#toDateError'), 'To Date must be after From Date.');
                valid = false;
            }

            if (itemList.length === 0) {
                Swal.fire("⚠️ Warning", "Please add at least one item.", "warning");
                valid = false;
            }

            if (!valid) return;

            Swal.fire({
                title: 'Send Plan for Approval?',
                text: "This action will submit the MRP plan.",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#198754',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, Submit'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({ title: 'Submitting...', text: 'Please wait...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });

                    const payload = {
                        PlanName: planName,
                        Year: $('#year').val(),
                        FromDate: fromDate,
                        ToDate: toDate,
                        Items: itemList
                    };

                    $.ajax({
                        type: 'POST',
                        url: '/Inventory/SubmitPlanForApprovalMHB',
                        contentType: 'application/json',
                        data: JSON.stringify(payload),
                        success: function (res) {
                            if (res.success) {
                                Swal.fire({ icon: 'success', title: '✅ Success', text: 'Plan submitted successfully!', showConfirmButton: false, timer: 1000 });
                                setTimeout(() => {
                                    itemList = [];
                                    renderTable();
                                    updateItemDropdown();
                                    $('#stockForm')[0].reset();
                                    $('#year').val(new Date().getFullYear());
                                    $('#fromDate').attr("min", today);
                                    $('#toDate').attr("min", today);
                                }, 1000);
                            } else Swal.fire('❌ Error', 'Failed to submit plan.', 'error');
                        },
                        error: function () { Swal.fire('❌ Server Error', 'Something went wrong.', 'error'); }
                    });
                }
            });
        });
    });

    // Utility functions
    function showError($input, $errElem, message) {
        $input.addClass('error-border');
        $errElem.text(message).removeClass('d-none');
    }
    function clearError($input, $errElem) {
        $input.removeClass('error-border');
        $errElem.text('').addClass('d-none');
    }

    function updateItemDropdown() {
        const ddl = $("#itemName").empty().append('<option value="">-- Select Item --</option>');
        allItems.forEach(i => {
            if (!itemList.some(g => g.ItemCode === i.ItemCode)) {
                ddl.append(`<option value="${i.ItemId}">${i.ItemName}</option>`);
            }
        });
    }

    function renderTable() {
        table.clear();
        itemList.forEach((item) => {
            table.row.add([
                item.ItemName, item.ItemCode, item.Quantity, item.UOM,
                `<span data-bs-toggle="tooltip" title="${item.Description}">${item.Description}</span>`,
                item.RequestType,
                `<button class="btn btn-sm btn-square btn-remove bg-danger" title="Remove" style="width: 32px; height: 32px;"><i class="bi bi-trash text-white"></i></button>`
            ]);
        });
        table.draw();
    }

    function clearFields() {
        $('#itemName').val('');
        $('#itemCode').val('');
        $('#uom').val('');
        $('#quantity').val('');
        $('#description').val('');
    }
</script>


